# KlipForge yalnızca bu adrese bağlanır. 0.0.0.0 kimlik doğrulamasız ağ erişimi açar.
KLIPFORGE_HOST=127.0.0.1
KLIPFORGE_PORT=3210

# Tüm kaynaklar, proje JSON'ları ve render çıktıları bu klasörde tutulur.
KLIPFORGE_DATA_DIR=./data

# CTranslate2 biçimindeki faster-whisper modellerinin yerel kökü.
KLIPFORGE_MODELS_DIR=./models

# Boş bırakılırsa models/ altındaki bilinen klasörler otomatik aranır.
# Örnek: ./models/faster-whisper-small
KLIPFORGE_WHISPER_MODEL=

# Varsayılan kapalıdır: çalışma zamanı ağdan model indirmez.
# Yalnızca bilinçli ve geçici ağ onayı için 1 yapın.
KLIPFORGE_ALLOW_MODEL_DOWNLOAD=0

# İsteğe bağlı, tamamen yerel semantik yeniden sıralama. Boşsa kapalıdır.
# Etkinleştirme örneği: KLIPFORGE_OLLAMA_MODEL=qwen3:4b
KLIPFORGE_OLLAMA_MODEL=

# Güvenlik gereği backend yalnızca localhost Ollama uç noktalarını kabul eder.
KLIPFORGE_OLLAMA_URL=http://127.0.0.1:11434

# Aynı anda çalışabilecek yerel analiz/render işi sayısı.
KLIPFORGE_WORKERS=1

# 8 GiB ve 6 saatlik varsayılan güvenlik sınırları.
KLIPFORGE_MAX_UPLOAD_BYTES=8589934592
KLIPFORGE_MAX_VIDEO_SECONDS=21600

